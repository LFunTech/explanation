# 本地启动无需凭证即可查看理科样例。任意题目生成必须配置千问。
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_TIMEOUT=180
# browser: 设备朗读；qwen: 合成并打包逐页语音文件；none: 无语音
TTS_MODE=browser
QWEN_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=Cherry
# 正式部署设置访问密钥。工作台登录与作业 API 使用同一服务密钥。
API_KEY=
PUBLIC_BASE_URL=http://127.0.0.1:18765
DATA_DIR=./data
WORKER_CONCURRENCY=2
# 回调只能调用配置中的完整 URL；用逗号分隔。禁止随请求指定任意地址。
CALLBACK_ALLOWED_URLS=
CALLBACK_SECRET=
# 可选知识检索接口，POST {question,limit}，返回 {resources:[Resource]}。
KNOWLEDGE_API_URL=
KNOWLEDGE_API_KEY=
# 可选 S3 / MinIO；生成产物先落本地，全部上传成功后才发布完成状态。
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_PREFIX=explanations

# 独立本地 PostgreSQL 知识库。不要填写远端 exam 数据库。
VECTOR_DATABASE_URL=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
# exam 公共教学资源的只读连接
EXAM_DB_HOST=
EXAM_DB_PORT=5432
EXAM_DB_NAME=exam
EXAM_DB_USER=
EXAM_DB_PASSWORD=
# exam 原题图片只读访问，与讲解包输出的 S3 配置分开。
EXAM_MINIO_ENDPOINT=
EXAM_MINIO_REGION=us-east-1
EXAM_MINIO_ACCESS_KEY=
EXAM_MINIO_SECRET_KEY=
EXAM_MINIO_ALLOWED_BUCKETS=exam
# 仅运行可选 compose.yaml 时使用
PG_PASSWORD=
